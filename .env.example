# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=monitor.session

# Comma-separated channel usernames or numeric chat IDs to monitor
SOURCE_CHATS=@freelance_channel,@python_jobs_feed

# Destination chat to forward matched leads (e.g. me, @username, or chat ID)
TARGET_CHAT=me

# Comma-separated include keywords (leave empty to score all non-stopped posts)
KEYWORDS=python,telegram,бот,aiogram,telethon,blender,autocad,roblox

# Comma-separated exclude words
STOP_WORDS=казино,ставки,крипта,рефералка

# Optional Google Gemini API key for AI relevance scoring (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MIN_AI_SCORE=6

# SQLite deduplication database
DB_PATH=data/seen_posts.db
